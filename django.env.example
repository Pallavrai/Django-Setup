DJANGO_SECRET_KEY='your_actual_secret_key_here_or_generate_one'
DEBUG=True

# PostgreSQL Settings (for development)
POSTGRES_DB=tht_db
POSTGRES_USER=tht_user
POSTGRES_PASSWORD=tht@12
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Production Database URL (for production deployment)
# DATABASE_URL=postgresql://username:password@host:port/database_name

# pgAdmin Settings
PGADMIN_DEFAULT_EMAIL=abc@gmail.com
PGADMIN_DEFAULT_PASSWORD=hello

ADMIN_USERNAME = abc
ADMIN_EMAIL = sfdsf@gmail.com
ADMIN_PASSWORD = sdfsdf

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://your-frontend-domain.com
CORS_ALLOW_CREDENTIALS=True

# Celery Configuration
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Email Configuration
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com

#Site url to include in Email
SITE_URL = http://localhost:3000


ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0